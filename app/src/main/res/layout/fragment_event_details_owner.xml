<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="event"
            type="com.myfzone_sport.myf_zone.domain.event.Event" />

        <variable
            name="owner"
            type="com.myfzone_sport.myf_zone.domain.event.EventOwner" />
    </data>

    <RelativeLayout
        android:id="@+id/owner_main_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/owner_scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?android:attr/actionBarSize"
            android:orientation="vertical"
            tools:context=".fragments.event.event_details.EventDetailsFragment">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/event_detail_owner_shimmer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/event_details_owner_shimmer_layout" />

                    </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/event_detail_owner_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ProgressBar
                        android:id="@+id/event_detail_progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />


                    <include
                        android:id="@+id/user_info_card_status"
                        layout="@layout/card_user_status_info" />

                    <include
                        android:id="@+id/event_detail_cardview_layout"
                        layout="@layout/event_detail_cardview_title"
                        bind:secondaryEvent="@{event}" />

                    <include
                        layout="@layout/event_detail_cardview_map"
                        bind:secondaryEvent="@{event}" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/event_detail_CardView_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:padding="8dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/MaterialAlertDialog.MaterialComponents.Title.Text"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="@string/team_txt"
                                android:textAlignment="textStart"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/event_detail_nbTeam"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="textEnd"
                                android:textSize="16sp"
                                android:textStyle="normal" />

                            <TextView
                                android:id="@+id/event_detail_nbTeam_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{`/` + event.getTeamNb}"
                                android:textAlignment="textEnd"
                                android:textSize="16sp"
                                android:textStyle="normal" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <include
                        android:id="@+id/cardEventOwner"
                        layout="@layout/card_event_owner_not_participant"
                        bind:owner="@{owner}" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/event_detail_participant_list"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_margin="4dp" />


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/event_detail_empty_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:padding="8dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">


                        <LinearLayout
                            android:id="@+id/no_participant_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="8dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/no_participant"
                                style="@style/MaterialAlertDialog.MaterialComponents.Title.Text"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:text="@string/no_participant_msg"
                                android:textAlignment="center"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/infoWindowCardLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorTransparentDiscreet"
            android:visibility="gone">

            <include
                android:id="@+id/infoWindowCard"
                layout="@layout/info_owner_event" />
        </LinearLayout>
    </RelativeLayout>

</layout>