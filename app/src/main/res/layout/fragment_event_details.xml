<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="event"
            type="com.myfzone_sport.myf_zone.domain.event.Event" />

        <variable
            name="validCount"
            type="Integer" />

        <variable
            name="owner"
            type="com.myfzone_sport.myf_zone.domain.event.EventOwner" />

        <variable
            name="affiliation"
            type="com.myfzone_sport.myf_zone.domain.coach.ClubAffiliation" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".app.ui.fragment.EventDetailsParticipantFragment">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/back_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_round_arrow_back_ios_new"/>

            <TextView
                android:id="@+id/page_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:fontFamily="@font/nuber_next_demi_bold_wide"
                android:gravity="center"
                android:text="Détails"
                android:textColor="@color/colorDesign1"
                android:textSize="16sp" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/event_details_participant_shimmer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/event_details_participant_shimmer_fragment_layout" />

                    </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/event_details_participant_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:id="@+id/event_detail_map_layout"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:background="@color/colorDesign1Transparent80"
                            android:contentDescription="map image"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <include
                            android:id="@+id/event_detail_map"
                            layout="@layout/event_map_preview"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <ImageView
                            android:id="@+id/event_detail_date"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_alignParentStart="true"
                            android:layout_marginVertical="95dp"
                            android:layout_marginStart="16dp"
                            android:contentDescription="date background"
                            app:srcCompat="@drawable/close_to_club_date_bg" />

                        <LinearLayout
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="95dp"
                            android:layout_marginStart="16dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/event_card_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_bold"
                                android:text="@{event.eventDateToDayNumber}"
                                android:textAlignment="center"
                                android:textColor="@color/quantum_white_text"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/event_card_month"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_medium"
                                android:text="@{event.eventDateToMonth}"
                                android:textAlignment="center"
                                android:textColor="@color/quantum_white_text"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </RelativeLayout>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/event_detail_layout_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16sp"
                        android:layout_marginEnd="16sp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/event_detail_map_layout">

                        <TextView
                            android:id="@+id/event_detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nuber_next_demi_bold_wide"
                            android:text="@{event.title}"
                            android:paddingBottom="2dp"
                            android:textColor="@color/colorDesign1"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/event_detail_map" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/event_detail_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/event_detail_time"
                                android:drawablePadding="4dp"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:gravity="start"
                                android:text="@{event.address}"
                                android:textColor="@color/colorDesign1Transparent75"
                                android:textSize="10sp"
                                app:drawableStartCompat="@mipmap/ic_mappin_2x" />

                            <TextView
                                android:id="@+id/event_detail_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:layout_marginStart="16dp"
                                android:drawablePadding="4dp"
                                android:gravity="center"
                                android:text="@{event.eventDateToHour}"
                                android:textColor="@color/colorDesign1Transparent75"
                                android:textSize="11sp"
                                app:drawableStartCompat="@mipmap/ic_clock_2x"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/event_detail_address" />
                        </RelativeLayout>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        android:id="@+id/event_detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nuber_next_regular_wide"
                        android:padding="16dp"
                        android:text="@{event.description}"
                        android:textColor="@color/colorDesign1Transparent80"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/event_detail_layout_header" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/event_detail_coach_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/event_detail_description">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.25"
                            android:gravity="start"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="Niveau"
                                android:textColor="@color/colorDesign2"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="@{owner.categoryName}"
                                android:textColor="@color/colorDesign1"
                                android:textSize="14sp" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.25"
                            android:gravity="start"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="Cat."
                                android:textColor="@color/colorDesign2"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="@{event.eventTypeString}"
                                android:textColor="@color/colorDesign1"
                                android:textSize="14sp" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:gravity="start"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="Coach"
                                android:textColor="@color/colorDesign2"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="@{owner.coachFullname}"
                                android:textColor="@color/colorDesign1"
                                android:textSize="14sp" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/event_detail_contact_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@mipmap/ic_nounchat_3x" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="Contacter"
                                android:textColor="@color/colorDesign2"
                                android:textSize="9sp" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/event_detail_event_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/event_detail_coach_info">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:gravity="start"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="Organisateur"
                                android:textColor="@color/colorDesign2"
                                android:textSize="11sp" />

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center">

                                <ImageView
                                    android:id="@+id/owner_club_image"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@mipmap/logo_updated_white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:fontFamily="@font/gilroy_semi_bold"
                                    android:text="@{owner.clubAcronym}"
                                    android:textColor="@color/colorDesign1"
                                    android:textSize="14sp" />

                            </androidx.appcompat.widget.LinearLayoutCompat>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:gravity="start"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/participant_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/gilroy_semi_bold"
                                android:text="@{`Participants (` + String.valueOf(validCount) + `/` + String.valueOf(event.nbTeam) + `)`}"
                                android:textColor="@color/colorDesign2"
                                android:textSize="11sp" />

                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:id="@+id/participant_list"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/participant_recyclerview"
                                    android:layout_width="128dp"
                                    android:layout_height="48dp"/>

                            </androidx.appcompat.widget.LinearLayoutCompat>

                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/event_detail_btn_layout"
                        app:layout_constraintTop_toBottomOf="@id/event_detail_event_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/event_detail_participate_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginStart="40dp"
                            android:layout_marginTop="40dp"
                            android:layout_marginEnd="40dp"
                            android:backgroundTint="@color/colorDesign2"
                            android:fontFamily="@font/nuber_next_bold"
                            android:text="Participer à cet évènement"
                            android:textAllCaps="false"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/event_detail_leave_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:visibility="gone"
                            android:layout_marginStart="40dp"
                            android:layout_marginTop="40dp"
                            android:layout_marginEnd="40dp"
                            android:backgroundTint="@android:color/holo_red_dark"
                            android:fontFamily="@font/nuber_next_bold"
                            android:text="Quitter l'évènement"
                            android:textAllCaps="false"
                            android:textSize="16sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        android:id="@+id/event_detail_share_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="8dp"
                        android:fontFamily="@font/gilroy_semi_bold"
                        android:text="Partager"
                        android:textColor="@color/colorDesign1Transparent75"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/event_detail_btn_layout"
                        app:drawableStartCompat="@mipmap/ic_share_2x" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </ScrollView>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
