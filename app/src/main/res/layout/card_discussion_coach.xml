<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <import type="android.view.View" />

        <variable
            name="chat"
            type="com.myfzone_sport.myf_zone.domain.chat.Chat" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/message_coach_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/image_club"
            android:src="@drawable/ic_account" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/message_coach_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/message_coach_name"
                    style="@style/TextAppearance.AppCompat.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/gilroy_semi_bold"
                    android:maxLines="2"
                    android:text="Contact 1"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/message_coach_lastMessage"
                        style="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/gilroy_semi_bold"
                        android:singleLine="true"
                        android:text="Ceci est un message - 17:14"
                        android:textSize="10sp" />

<!--                    <TextView-->
<!--                        android:id="@+id/message_coach_lastMessageDate"-->
<!--                        style="@style/ShapeAppearance.MaterialComponents.MediumComponent"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_marginTop="4dp"-->
<!--                        android:fontFamily="@font/gilroy_semi_bold"-->
<!--                        android:singleLine="true"-->
<!--                        android:text=" - 17:14"-->
<!--                        android:textSize="10sp" />-->

                </androidx.appcompat.widget.LinearLayoutCompat>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>
</layout>