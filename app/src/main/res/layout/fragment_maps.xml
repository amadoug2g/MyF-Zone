<?xml version="1.0" encoding="utf-8"?>

<layout>

    <data>

        <variable
            name="event"
            type="com.myfzone_sport.myf_zone.model.event.Event" />

        <variable
            name="viewModel"
            type="com.myfzone_sport.myf_zone.fragments.maps.MapsViewModel" />

    </data>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/mapsViewFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/MapTheme"
        tools:context=".fragments.maps.MapsFragment">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/loadLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="64dp"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="64dp"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:visibility="invisible">

            <ProgressBar
                android:id="@+id/mapProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="@color/colorSettingEnd" />

            <TextView
                android:id="@+id/mapProgressBarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/loading"
                android:textColor="@color/colorSettingStart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_button"
                style="@style/map_button_style"
                android:layout_marginStart="15dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/colorAccent"
                android:drawableEnd="@drawable/filter_icons_all_2"
                android:drawablePadding="0dp"
                android:text="@{`(` + String.valueOf(viewModel.filterCount) + `) `}" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_button_ball"
                style="@style/map_button_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/colorAccent"
                android:drawableEnd="@mipmap/ic_ball_filter"
                android:drawablePadding="0dp"
                android:text="@{`(` + String.valueOf(viewModel.filterCountFriendly) + `) `}"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_button_cup"
                style="@style/map_button_style"
                android:layout_marginStart="15dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/colorAccent"
                android:drawableEnd="@mipmap/ic_cup_filter"
                android:drawablePadding="0dp"
                android:text="@{`(` + String.valueOf(viewModel.filterCountTourney) + `) `}"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_button_stadium"
                style="@style/map_button_style"
                android:layout_marginStart="15dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/colorAccent"
                android:drawableEnd="@mipmap/ic_stadium_filter"
                android:drawablePadding="0dp"
                android:text="@{`(` + String.valueOf(viewModel.filterCountPlateau) + `) `}"
                android:visibility="gone" />

        </LinearLayout>

        <include
            android:id="@+id/cardEventDetail"
            layout="@layout/card_event_item" />
    </RelativeLayout>
</layout>

