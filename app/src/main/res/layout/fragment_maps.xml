<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/MapTheme"
    tools:context=".fragments.MapsFragment">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/list_button"
        style="@style/map_button_style"
        android:layout_alignParentStart="true"
        android:layout_marginStart="15dp"
        android:contentDescription="@string/list_button_desc"
        android:src="@drawable/ic_list" />

    <ImageView
        android:id="@+id/message_button"
        style="@style/map_button_style"
        android:layout_toStartOf="@+id/account_button"
        android:contentDescription="@string/message_button_desc"
        android:src="@drawable/ic_message" />

    <ImageView
        android:id="@+id/account_button"
        style="@style/map_button_style"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="15dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/account_button_desc"
        android:focusable="true"
        android:src="@drawable/ic_account" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardView_detail"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/cardView_clubImage"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/image_club"
                android:src="@drawable/pffc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/cardView_clubImage"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/cardView_clubName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/club_name"
                    android:textColor="@android:color/black"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/club_subtitle"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="16sp" />

            </LinearLayout>
        </RelativeLayout>


    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
