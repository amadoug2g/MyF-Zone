<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?android:attr/actionBarSize"
            android:theme="@style/AppTheme">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="90dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerHorizontal="true"
                        android:contentDescription="@string/app_logo_content_description"
                        android:src="@drawable/ic_logo" />

                    <TextView
                        android:id="@+id/textView_intro"
                        style="@style/TextAppearance.AppCompat.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="70dp"
                        android:layout_marginBottom="20dp"
                        android:text="@string/onBoarding_intro"
                        android:textAlignment="center"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView_add_event"
                        style="@style/TextAppearance.AppCompat.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView_intro"
                        android:layout_marginStart="20dp"
                        android:drawablePadding="4dp"
                        android:padding="2dp"
                        android:text="@string/onBoarding_create_event"
                        android:textAlignment="center"
                        app:drawableStartCompat="@drawable/ic_add" />

                    <LinearLayout
                        android:id="@+id/event_icons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView_add_event"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:id="@+id/tournament_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tournament_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:text="@string/tournament_event"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                app:drawableTopCompat="@mipmap/ic_cup" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/plateau_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/plateau_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:text="@string/plateau_event"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                app:drawableTopCompat="@mipmap/ic_stadium" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/friendly_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/friendly_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:text="@string/friendly_event_txt"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold"
                                app:drawableTopCompat="@mipmap/ic_ball" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView_calendar"
                        style="@style/TextAppearance.AppCompat.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/event_icons"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:drawablePadding="4dp"
                        android:padding="2dp"
                        android:text="@string/onBoarding_calendar"
                        app:drawableStartCompat="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/textView_map"
                        style="@style/TextAppearance.AppCompat.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView_calendar"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:drawablePadding="4dp"
                        android:padding="2dp"
                        android:text="@string/onBoarding_map"
                        app:drawableStartCompat="@drawable/ic_location_accent" />

                    <TextView
                        android:id="@+id/textView_chat"
                        style="@style/TextAppearance.AppCompat.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView_map"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:drawablePadding="4dp"
                        android:padding="2dp"
                        android:text="@string/onBoarding_chat"
                        app:drawableStartCompat="@drawable/ic_chat" />

                    <View
                        android:id="@+id/separator"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/textView_chat"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="10dp"
                        android:background="#c0c0c0" />

                    <TextView
                        android:id="@+id/textView_affiliation_code"
                        style="@style/TextAppearance.AppCompat.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/separator"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="10dp"
                        android:padding="4dp"
                        android:text="@string/onBoarding_affiliation_code"
                        android:textAlignment="center" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/continue_on_boarding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textView_affiliation_code"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:enabled="false"
                        android:text="@string/continue_text" />

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/checkbox_on_boarding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/continue_on_boarding"
                        android:layout_centerHorizontal="true"
                        android:text="@string/understood_text" />

                </RelativeLayout>


            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</layout>