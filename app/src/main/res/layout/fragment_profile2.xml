<?xml version="1.0" encoding="utf-8"?>
<layout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@mipmap/ic_pffc_logo"
                android:contentDescription="Club image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nuber_next_bold"
                android:text="Nom de votre club"
                android:gravity="center"
                android:textColor="@color/colorDesign1"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nuber_next_regular_wide"
                android:text="Entraineur du club"
                android:gravity="center"
                android:textColor="@color/colorDesign1Transparent80"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nuber_next_bold"
                android:text="Mes informations"
                android:textColor="@color/colorDesign1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/coach_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nuber_next_regular_wide"
                android:text="Mes informations"
                android:textColor="@color/colorDesign1Transparent80"
                android:textSize="12sp" />

        </LinearLayout>

        <include
            android:id="@+id/user_event_layout"
            layout="@layout/home_coach_event_layout" />

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/participation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/nuber_next_bold"
                    android:text="Mes participations"
                    android:textColor="@color/colorDesign1"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/participation_show_all"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="0dp"
                    android:fontFamily="@font/nuber_next_bold"
                    android:letterSpacing="0.01"
                    android:padding="0dp"
                    android:text="Tout afficher"
                    android:textAllCaps="false"
                    android:textColor="@color/colorDesign2"
                    android:textSize="12sp" />

            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/participation_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="true"
                android:scrollbarThumbHorizontal="@drawable/home_scrollbar_thumb"
                android:scrollbarTrackHorizontal="@drawable/home_scrollbar_track"
                android:scrollbars="horizontal" />

        </LinearLayout>

    </LinearLayout>

</layout>
