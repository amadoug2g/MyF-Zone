<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>

        <variable
            name="participant"
            type="com.myfzone_sport.myf_zone.domain.event.EventParticipant" />
    </data>
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <ImageView
            android:id="@+id/event_participant_image"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_account_home"
            android:layout_centerVertical="true"
            android:contentDescription="@string/lorem" />

        <TextView
            android:id="@+id/event_participant_name"
            android:layout_toEndOf="@id/event_participant_image"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:fontFamily="@font/gilroy_semi_bold"
            android:textColor="@color/colorDesign1"
            android:textSize="14sp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@{participant.coachFullname}"/>

        <ImageView
            android:id="@+id/event_participant_action_button"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/accept_2x_design_1"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/lorem" />

    </RelativeLayout>
</layout>