<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="participant"
            type="mfz.myfzone_sport.myf_zone.model.event.EventParticipant" />
    </data>


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/event_detail_CardView_participant"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/event_detail_participant_image"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_centerVertical="true"
                    android:layout_margin="8dp"
                    android:contentDescription="@string/participant_image"
                    android:src="@drawable/ic_account" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/event_detail_participant_image">

                    <LinearLayout
                        android:id="@+id/event_detail_owner_info"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_margin="8dp"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/event_detail_owner_club"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.AppCompat.Title"
                            android:text="@{@string/participant_txt + ` - ` + participant.clubAcronym + ` ` + participant.categoryName + ` ` + participant.subCategoryName}" />

                        <TextView
                            android:id="@+id/event_detail_owner_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            style="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                            android:text="@{participant.coachFullname}" />

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="8dp">

                        <ImageView
                            android:id="@+id/notificationDotOwner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/notification_dot_blue"
                            android:contentDescription="@string/notification_dot" />

                        <ImageButton
                            android:id="@+id/cancel_participation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/colorTransparent"
                            android:clickable="true"
                            android:contentDescription="@string/cancel_participation"
                            android:focusable="true"
                            android:src="@drawable/ic_remove" />

                        <TextView
                            android:id="@+id/event_detail_id"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                    </RelativeLayout>

                </RelativeLayout>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</layout>