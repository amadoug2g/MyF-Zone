<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="event"
            type="com.myfzone_sport.myf_zone.domain.event.Event" />

        <variable
            name="viewModel"
            type="com.myfzone_sport.myf_zone.fragments.maps.MapsViewModel" />

    </data>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/mapsViewFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/MapTheme"
        tools:context=".app.ui.fragments.MapsFragment">


        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/quantum_white_text">

            <ImageButton
                android:id="@+id/back_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_round_arrow_back_ios_new" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:fontFamily="@font/nuber_next_demi_bold_wide"
                android:gravity="center"
                android:text="Carte"
                android:textColor="@color/colorDesign1"
                android:textSize="16sp" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_margin="15dp"
            android:layout_alignParentBottom="true"/>

<!--        <include-->
<!--            android:id="@+id/cardEventDetail"-->
<!--            layout="@layout/card_event_item" />-->

    </RelativeLayout>

</layout>