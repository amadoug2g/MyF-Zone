<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_start"
    app:startDestination="@id/loginFragment2">

    <fragment
        android:id="@+id/loginFragment2"
        android:name="com.myfzone_sport.myf_zone.app.ui.LoginFragment"
        tools:layout="@layout/fragment_login2">
        <action
            android:id="@+id/loginFragmentToHomeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/loginFragmentToSignUpFragment2"
            app:destination="@id/signUpFragment2" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.myfzone_sport.myf_zone.app.ui.HomeFragment"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/signUpFragment2"
        android:name="com.myfzone_sport.myf_zone.app.ui.SignUpFragment"
        tools:layout="@layout/fragment_sign_up2">
        <action
            android:id="@+id/signUpFragment2ToSignInFragment"
            app:destination="@id/signInFragment" />
    </fragment>
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.myfzone_sport.myf_zone.app.ui.SignInFragment"
        tools:layout="@layout/fragment_sign_in" />
</navigation>