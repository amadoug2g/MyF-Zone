<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/map2"
    app:startDestination="@id/mapFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.myfzone_sport.myf_zone.app.ui.fragment.MapsFragment"
        tools:layout="@layout/fragment_maps2"
        android:label="Map2">
        <action
            android:id="@+id/mapFragmentToEventDetailsFragment"
            app:destination="@id/event_details_for_participant" />
        <action
            android:id="@+id/mapFragmentToEventDetailsGuestFragment"
            app:destination="@id/event_details_for_guest" />
    </fragment>
    <include app:graph="@navigation/event_details_for_participant" />
    <include app:graph="@navigation/event_details_for_guest" />
</navigation>