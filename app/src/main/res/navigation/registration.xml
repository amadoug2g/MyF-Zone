<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registration"
    app:startDestination="@id/signUpFragment2">

    <fragment
        android:id="@+id/signUpFragment2"
        android:name="com.myfzone_sport.myf_zone.app.ui.fragment.SignUpFragment"
        tools:layout="@layout/fragment_sign_up2">
        <action
            android:id="@+id/signUpFragment2ToSignInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/signUpFragment2ToAffiliationFragment"
            app:destination="@id/affiliation" />
    </fragment>
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.myfzone_sport.myf_zone.app.ui.fragment.SignInFragment"
        tools:layout="@layout/fragment_sign_in" >
        <action
            android:id="@+id/signInFragment2ToAffiliationFragment"
            app:destination="@id/affiliation" />
    </fragment>
    <include app:graph="@navigation/affiliation" />
</navigation>