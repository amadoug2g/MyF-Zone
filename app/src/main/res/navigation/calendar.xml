<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar"
    android:label="@string/calendar"
    app:startDestination="@+id/calendarFragment"
    tools:ignore="UnusedNavigation">

    <fragment
        android:id="@+id/calendarFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.calendar.CalendarFragment"
        android:label="@string/calendar"
        tools:layout="@layout/fragment_calendar">
        <action
            android:id="@+id/calendarToEventCreation"
            app:destination="@id/eventCreationFragment" />
    </fragment>
    <fragment
        android:id="@+id/eventCreationFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.calendar.EventCreationFragment"
        android:label="@string/new_event"
        tools:layout="@layout/fragment_event_creation" />
</navigation>