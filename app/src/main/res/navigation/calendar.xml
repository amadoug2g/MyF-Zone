<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar"
    android:label="@string/calendar"
    app:startDestination="@+id/calendarFragment"
    tools:ignore="UnusedNavigation">

    <fragment
        android:id="@+id/calendarFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.calendar.calendar.CalendarFragment"
        android:label=""
        tools:layout="@layout/fragment_calendar">
        <action
            android:id="@+id/calendarToEventCreation"
            app:destination="@id/eventCreationFragment" />
        <action
            android:id="@+id/calendarToEventDetail"
            app:destination="@+id/event_detail" />
        <action
            android:id="@+id/calendarToLogin"
            app:destination="@id/login" />
        <action
            android:id="@+id/calendarToAffiliationRequest"
            app:destination="@id/affiliation_request" />
        <action
            android:id="@+id/calendarToProfile"
            app:destination="@id/profile" />
    </fragment>
    <fragment
        android:id="@+id/eventCreationFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.calendar.event_creation.EventCreationFragment"
        android:label="@string/new_event"
        tools:layout="@layout/fragment_event_creation" />
    <include app:graph="@navigation/event_detail" />
    <include app:graph="@navigation/profile" />
    <include app:graph="@navigation/affiliation_request" />
    <include app:graph="@navigation/login" />
</navigation>