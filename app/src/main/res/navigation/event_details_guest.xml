<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_details_guest"
    app:startDestination="@id/eventDetailsGuestFragment">

    <fragment
        android:id="@+id/eventDetailsGuestFragment"
        android:name="com.myfzone_sport.myf_zone.fragments.event.event_details.guest.EventDetailsGuestFragment"
        android:label=""
        tools:layout="@layout/fragment_event_details_guest">
        <action
            android:id="@+id/eventDetailsToSignUp"
            app:destination="@id/login" />
        <action
            android:id="@+id/eventDetailsToAffiliationRequest"
            app:destination="@id/affiliation_request" />
    </fragment>
    <include app:graph="@navigation/affiliation_request" />
    <include app:graph="@navigation/login" />
</navigation>