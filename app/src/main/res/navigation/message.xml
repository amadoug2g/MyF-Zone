<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/message"
    android:label="@string/message_page"
    app:startDestination="@id/messageFragment"
    tools:ignore="UnusedNavigation">

    <fragment
        android:id="@+id/messageFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.message.MessageFragment"
        android:label=""
        tools:layout="@layout/fragment_message">
        <action
            android:id="@+id/messageToProfile"
            app:destination="@id/profile" />
        <action
            android:id="@+id/messageToLogin"
            app:destination="@id/login" />
        <action
            android:id="@+id/messageToAffiliationRequest"
            app:destination="@id/affiliation_request" />
        <action
            android:id="@+id/messageToDiscussion"
            app:destination="@id/discussion" />
    </fragment>
    <include app:graph="@navigation/profile" />
    <include app:graph="@navigation/affiliation_request" />
    <include app:graph="@navigation/login" />
    <include app:graph="@navigation/discussion" />
</navigation>