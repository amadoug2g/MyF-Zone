<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_detail"
    app:startDestination="@id/eventDetailsFragment">

    <fragment
        android:id="@+id/eventDetailsFragment"
        android:name="com.myfzone_sport.myf_zone.fragments.event.event_details.EventDetailsFragment"
        android:label=""
        tools:layout="@layout/fragment_event_details">
        <action
            android:id="@+id/eventDetailsToEventEdit"
            app:destination="@id/eventEditFragment" />
        <action
            android:id="@+id/eventDetailsToDiscussion"
            app:destination="@id/discussion" />
        <action
            android:id="@+id/eventDetailsToSignUp"
            app:destination="@id/login" />
        <action
            android:id="@+id/eventDetailsToAffiliationRequest"
            app:destination="@id/affiliation_request" />
    </fragment>
    <fragment
        android:id="@+id/eventEditFragment"
        android:name="com.myfzone_sport.myf_zone.fragments.event.event_edit.EventEditFragment"
        android:label="@string/edit_txt" />
    <include app:graph="@navigation/discussion" />
    <include app:graph="@navigation/affiliation_request" />
    <include app:graph="@navigation/login" />
</navigation>