<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login"
    app:startDestination="@id/signUpFragment">

    <action
        android:id="@+id/globalToAffiliation"
        app:destination="@id/affiliation_request"
        app:launchSingleTop="true"
        app:popUpTo="@id/affiliation_request"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.user_sign.login.LoginFragment"
        android:label="@string/login_coach">
        <action
            android:id="@+id/loginToSignUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/loginToMaps"
            app:destination="@id/map" />
        <action
            android:id="@+id/loginToMessage"
            app:destination="@id/message" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="mfz.myfzone_sport.myf_zone.fragments.user_sign.sign_up.SignUpFragment"
        android:label="@string/become_coach">
        <action
            android:id="@+id/signUpToAffiliationRequest"
            app:destination="@id/affiliation_request" />
        <action
            android:id="@+id/signUpToLogin"
            app:destination="@id/loginFragment" />
    </fragment>

</navigation>