<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.myfzone_sport.myf_zone.app.ui.fragment.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/homeFragmentToCategoryListFragment"
            app:destination="@id/category_list" />
        <action
            android:id="@+id/homeFragmentToRegistrationFragment"
            app:destination="@id/registration" />
        <action
            android:id="@+id/homeFragmentToNewEventFragment"
            app:destination="@id/new_event" />
        <action
            android:id="@+id/homeFragmentToProfilFragment"
            app:destination="@id/profil" />
        <action
            android:id="@+id/homeFragmentToMessageFragment"
            app:destination="@id/message2" />
        <action
            android:id="@+id/homeFragmentToMapFragment"
            app:destination="@id/map2" />
    </fragment>
    <include app:graph="@navigation/category_list" />
    <include app:graph="@navigation/registration" />
    <include app:graph="@navigation/new_event" />
    <include app:graph="@navigation/profil" />
    <include app:graph="@navigation/message2" />
    <include app:graph="@navigation/map2" />
</navigation>